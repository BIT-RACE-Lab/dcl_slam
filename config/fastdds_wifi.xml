<?xml version="1.0" encoding="UTF-8" ?>
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <!--
    DCL-SLAM real-robot DDS transport.

    Both robots use this same file.  Fast DDS ignores whitelist addresses that
    are not assigned to the current host, so robot a selects 192.168.31.11 and
    robot b selects 192.168.31.12.  Loopback keeps local ROS 2 CLI tools usable.
    Update the addresses if the robot Wi-Fi subnet changes.
  -->
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>dcl_wifi_udp</transport_id>
      <type>UDPv4</type>
      <!-- Probe enough participant IDs for the bridge and ROS 2 CLI daemon. -->
      <maxInitialPeersRange>32</maxInitialPeersRange>
      <interfaceWhiteList>
        <address>127.0.0.1</address>
        <address>192.168.31.11</address>
        <address>192.168.31.12</address>
      </interfaceWhiteList>
    </transport_descriptor>
  </transport_descriptors>

  <participant profile_name="dcl_wifi_participant" is_default_profile="true">
    <rtps>
      <useBuiltinTransports>false</useBuiltinTransports>
      <userTransports>
        <transport_id>dcl_wifi_udp</transport_id>
      </userTransports>
      <!--
        Explicit unicast peers make discovery independent of Wi-Fi multicast
        forwarding and prevent the MID360 Ethernet NIC from being selected.
      -->
      <builtin>
        <initialPeersList>
          <locator>
            <udpv4>
              <address>192.168.31.11</address>
            </udpv4>
          </locator>
          <locator>
            <udpv4>
              <address>192.168.31.12</address>
            </udpv4>
          </locator>
        </initialPeersList>
      </builtin>
    </rtps>
  </participant>
</profiles>
