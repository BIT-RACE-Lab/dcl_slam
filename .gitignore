# 已内置的第三方源码必须纳入顶层 Git。
# 请将依赖源码放在 ros1_ws/src/<package>/third_party/，不要放在 build/。
!ros1_ws/src/**/third_party/
!ros1_ws/src/**/third_party/**

# ROS / catkin 工作区生成内容
/build/
/devel/
/install/
/logs/
/.catkin_tools/
/ros1_ws/build/
/ros1_ws/devel/
/ros1_ws/install/
/ros1_ws/logs/
/ros1_ws/.catkin_tools/
/ros2_ws/build/
/ros2_ws/install/
/ros2_ws/log/
/ros2_ws/.colcon/

# wstool 自动生成的依赖清单及备份
**/.rosinstall
**/.rosinstall.bak

# # Livox ROS1 当前使用的包清单（其上游 .gitignore 默认将其排除）
# !ros1_ws/src/livox_ros_driver2/package.xml

# # ROS 运行时与数据记录（数据集请放在仓库外，或使用 Git LFS 单独管理）
# *.bag
# *.db3
# *.mcap
# *.pcap
# *.pcd

# 编译与 Python 缓存
*.py[cod]
__pycache__/
# *.so
# *.o
# *.a
# *.la
# *.dylib
# *.dll
# *.exe

# IDE、编辑器与操作系统文件
.vscode/
.idea/
*.swp
*.swo
# *~
# .DS_Store
# Thumbs.db

# # 本机环境、密钥与临时日志
# .env
# .env.*
# !.env.example
# *.log
# *.tmp
